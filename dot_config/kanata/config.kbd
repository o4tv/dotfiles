(defcfg
  process-unmapped-keys   yes
  concurrent-tap-hold     yes
  allow-hardware-repeat   no
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  v-w C-rght
  v-b C-left
  v-4 end
  v-0 home
  nav (layer-while-held vim_layer)
)

(defchordsv2
  (m 1) (layer-switch qwerty) 300 all-released ()
  (m 2) (layer-switch canary) 300 all-released ()
)

(deflayer qwerty
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @nav _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

(deflayer canary
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  w    l    y    p    k    z    x    o    u    ;    [    ]    \
  @nav c    r    s    t    b    f    n    e    i    a    '    ret
  lsft j    v    d    g    q    m    h    /    ,    .    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer vim_layer
  _    _    _    _    @v-4 @v-0 _    _    _    _    _    _    _    _
  _    @v-w _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    left down up   rght _    _    _
  _    _    _    _    @v-b _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
